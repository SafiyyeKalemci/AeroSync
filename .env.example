ENVIRONMENT=development
LOG_LEVEL=INFO

# API güvenliği: boş bırakılırsa korumalı endpointler 503 döner.
AEROSYNC_SECRET_KEY=change-me
TEAM_USER_URL=
LOCAL_BACKEND_URL=http://127.0.0.1:8000
COMPETITION_URL=
HTTP_TIMEOUT_SECONDS=5.0
SESSION_DURATION_SECONDS=3600

# TEKNOFEST resmî Takım Bağlantı Arayüzü. PASSWORD bilinçli olarak boştur.
TEAM_NAME=
PASSWORD=
EVALUATION_SERVER_URL=
SESSION_NAME=
OFFICIAL_INTERFACE_PATH=official_interface
OFFICIAL_MEDIA_DIR=./work/official_media
